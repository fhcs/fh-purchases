{
    "name": "fitnesshouse/purchases",
    "description": "Purchases manager",
    "license": "MIT",
    "keywords": ["laravel", "purchases"],
    "homepage": "https://github.com/fhcs/fh-purchases",
    "authors": [
        {
            "name": "Mikhaylov.V",
            "email": "mihailov.v@fhclub.ru"
        }
    ],
    "require": {
        "php": "^7.3|^8.0",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.3.3|^10.5|^11.5",
        "orchestra/testbench": "^5.0|^6.0|^7.0|^8.0|^9.0|^10.0",
        "laravel/legacy-factories": "^1.4"
    },
    "autoload": {
        "files": [
            "src/Helpers/helpers.php"
        ],
        "psr-4": {
            "Fh\\Purchase\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fh\\Purchase\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fh\\Purchase\\PurchaseServiceProvider"
            ],
            "dont-discover": [
                "*"
            ]
        },
        "branch-alias": {
            "dev-master": "1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
